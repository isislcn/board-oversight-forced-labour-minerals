# Copy to .env and fill in locally. Never commit .env.
# Names only — no real values in this file.

# Sayari API (https://sayari.com)
SAYARI_CLIENT_ID=
SAYARI_CLIENT_SECRET=

# Tavily API (https://tavily.com) — discovery only
TAVILY_API_KEY=

# SEC EDGAR fair-access policy requires a declared User-Agent:
# "<Organisation or project name> <contact email>"
SEC_USER_AGENT=

# Build profile: "public" (licence-permitted data only) or "research" (local, private)
BUILD_PROFILE=public
